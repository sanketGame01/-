<items xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="items.xsd">

	<itemtypes>
		<itemtype generate="true" code="GenerateDescriptionsCronJob" extends="CronJob" autocreate="true">
			<description>Bulk-generates product descriptions with an LLM on the Staged catalog version</description>
			<attributes>
				<attribute qualifier="catalogId" type="java.lang.String">
					<description>Product catalog id, e.g. electronicsProductCatalog</description>
					<modifiers optional="false"/>
					<defaultvalue>"electronicsProductCatalog"</defaultvalue>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="overwrite" type="java.lang.Boolean">
					<description>Replace existing descriptions</description>
					<defaultvalue>Boolean.FALSE</defaultvalue>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="batchSize" type="java.lang.Integer">
					<description>Products loaded per page</description>
					<defaultvalue>Integer.valueOf(20)</defaultvalue>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="maxProducts" type="java.lang.Integer">
					<description>Maximum number of products sent to the LLM per run (0 = no limit)</description>
					<defaultvalue>Integer.valueOf(20)</defaultvalue>
					<persistence type="property"/>
				</attribute>
			</attributes>
		</itemtype>
	</itemtypes>
</items>

